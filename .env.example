# Copy to .env. The TUI and eval commands load it; shell variables take precedence.
XAI_API_KEY=
# Optional comparison providers:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Choose distinct model IDs available to your account; the verifier must support images.
EXTRACTOR_MODEL=
VERIFIER_MODEL=
# Optional Chat Completions-compatible endpoints and credential environment names:
# EXTRACTOR_URL=https://api.x.ai/v1
# VERIFIER_URL=https://api.x.ai/v1
# EXTRACTOR_KEY_ENV=XAI_API_KEY
# VERIFIER_KEY_ENV=XAI_API_KEY

# Optional explicit batching/request overrides; leave unset by default.
# The provider enforces actual context/image/request limits. Capacity errors split work.
# MODEL_CHUNK_SOURCE_BYTES=
# MODEL_CHUNK_PAGES=
# MODEL_REQUEST_BYTES=
# MODEL_REQUEST_IMAGES=
# MODEL_OUTPUT_TOKENS=
# MODEL_CONTEXT_TOKENS is retired: byte counts were not real token counts.
